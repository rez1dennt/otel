{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.1",
    "wp": "latest"
  },
  "extraLibraries": ["wp-cli"],
  "login": true,
  "landingPage": "/",
  "siteOptions": {
    "blogname": "FORMA Hotel"
  },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "FORMA_SMTP_USER": "mailbox@example.test",
        "FORMA_SMTP_PASSWORD": "PLAYGROUND_ONLY_APP_PASSWORD",
        "FORMA_LEAD_RECIPIENT": "recipient@example.test"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/forma-lead-mail-test.php",
      "data": {
        "resource": "bundled",
        "path": "/lead-mail-test.php"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "bundled",
        "path": "/theme.zip"
      },
      "options": {
        "activate": true
      },
      "ifAlreadyInstalled": "error"
    },
    {
      "step": "wp-cli",
      "command": "wp eval 'forma_hotel_bootstrap_site();'"
    }
  ]
}
